{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/lib.ts",
    "src/CityMap.tsx",
    "src/Icon.tsx",
    "src/data/content.ts",
    "src/map-style.ts",
    "src/vite-env.d.ts",
    "tests",
    "api",
    "server",
    "shared"
  ]
}
